ROBOFLOW_API_KEY=your-private-api-key
ROBOFLOW_MODEL_ID=pushup-detector/2
CAMERA_INDEX=0
# Class names your model uses for the two pushup positions
UP_CLASS=pushup
DOWN_CLASS=pushdown
# Anti-cheat: min box width/height ratio, and min drop of box top (fraction of frame height)
MIN_ASPECT=1.3
MIN_DROP=0.05
